[Unit]
Description=MIC-712-OX dual-fan PWM sync
Documentation=https://github.com/avocado-linux/bsp-mic-712-ox-16gb
# The SoC thermal governor only drives the primary pwm-fan; mirror its duty
# cycle onto the secondary (pwm5-fan) so both fans track temperature.
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/mic-712-ox fan-sync --daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
